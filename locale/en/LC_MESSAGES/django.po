#: server/agents/tools/documents.py:11
msgid "파일은 10MB 이하로 입력하세요."
msgstr "Upload a file of 10MB or less."

#: server/agents/tools/documents.py:16
msgid "80쪽 이하 문서를 입력하세요."
msgstr "Enter a document of 80 pages or fewer."

#: server/agents/tools/documents.py:19
msgid "PDF를 읽을 수 없습니다. 손상되었거나 암호가 걸렸는지 확인하세요."
msgstr ""
"Could not read the PDF. Check whether it is damaged or password-protected."

#: server/agents/tools/documents.py:23
msgid "PDF 또는 UTF-8 TXT를 입력하세요."
msgstr "Enter a PDF or a UTF-8 TXT file."

#: server/agents/tools/documents.py:27
msgid ""
"추출 가능한 본문을 10만 자 이내로 입력하세요. 이미지 PDF는 텍스트 변환이 필요"
"합니다."
msgstr ""
"Enter between 1 and 100,000 characters of extractable text. Image-only PDFs "
"need text conversion."

#: server/agents/tools/documents.py:49
msgid "인용 페이지 또는 내용이 잘못되었습니다."
msgstr "The citation page or content is invalid."

#: server/agents/tools/documents.py:51
#, python-format
msgid "인용은 %(n)s자 이상의 원문 구간이어야 합니다."
msgstr ""
"A citation must be a stretch of the original text of at least %(n)s "
"characters."

#: server/agents/tools/documents.py:54
#, python-format
msgid "모델이 제시한 인용이 원문과 일치하지 않습니다: %(page)s쪽 \"%(quote)s\""
msgstr ""
"The citation the model gave does not match the original: p. %(page)s "
"\"%(quote)s\""

#: server/agents/tools/sources.py:124
#, python-format
msgid "도구로 읽지 않은 서버 자료는 인용할 수 없습니다: %(id)s %(page)s쪽"
msgstr ""
"A server source that was not read with the tool cannot be cited: %(id)s p. "
"%(page)s"

#: server/agents/tools/sources.py:128
#, python-format
msgid "서버 자료 %(id)s %(page)s쪽 인용 오류. %(reason)s"
msgstr "Server source %(id)s p. %(page)s citation error. %(reason)s"

#: server/agents/validation.py:10
msgid "응답 필드의 자료형이 잘못되었습니다."
msgstr "A response field has the wrong type."

#: server/agents/validation.py:12
msgid "응답의 상태 값이 허용된 범위를 벗어났습니다."
msgstr "A response value is outside the allowed range."

#: server/agents/validation.py:15
msgid "응답의 필수 필드 또는 허용 필드를 확인하세요."
msgstr "Check the required and allowed fields in the response."

#: server/agents/validation.py:22
msgid "응답에 빈 필드가 있습니다. 해당 사항이 없으면 그 이유를 적어 주세요."
msgstr ""
"The response has an empty field. If it does not apply, write the reason."

#: server/agents/validation.py:36
msgid "이해가 서로 다른 역할을 2~3명 반환해야 합니다."
msgstr "Return 2 to 3 roles with different interests."

#: server/agents/validation.py:39
msgid "역할 이름은 100자, 설명은 2000자 이내로 작성하세요."
msgstr "Keep role names within 100 characters and descriptions within 2000."

#: server/agents/validation.py:46
msgid "이 단계에는 항목이 하나 이상 필요합니다."
msgstr "This step needs at least one item."

#: server/agents/validation.py:48
msgid "한 차례에는 항목을 하나만 작성하세요."
msgstr "Write only one item per turn."

#: server/agents/validation.py:50
#, python-format
msgid "쟁점은 최대 %(n)s개까지 고르세요."
msgstr "Choose at most %(n)s issues."

#: server/agents/validation.py:54
msgid "현재 단계에서 참조할 수 없는 발언 ID가 있습니다."
msgstr "Some statement IDs cannot be referenced at this step."

#: server/agents/validation.py:56
msgid "검토한 이전 발언 ID를 연결하세요."
msgstr "Link the IDs of the earlier statements you reviewed."

#: server/agents/validation.py:59
msgid "배정된 쟁점과 상대 주장 모두에 답해야 합니다: "
msgstr "You must answer every assigned issue and opposing claim: "

#: server/integrations/transport.py:75
msgid "모델 응답이 비어 있습니다."
msgstr "The model response was empty."

